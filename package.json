{
  "name": "dsh-bili-interactor",
  "version": "0.2.0",
  "description": "DSH 插件：让 AI 替你逛 B站 并真的产生互动 —— 点赞 / 投币 / 弹幕 / 评论 / 回评论 / 回复监听，带可视化面板",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "bot",
    "automation",
    "panel"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "py",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acttk/dsh-bili-interactor.git"
  },
  "bugs": {
    "url": "https://github.com/acttk/dsh-bili-interactor/issues"
  },
  "homepage": "https://github.com/acttk/dsh-bili-interactor#readme",
  "scripts": {
    "test": "node smoke.mjs && node smoke-host.mjs && node tests/test_dedupe.mjs && node tests/test_reply_pick.mjs && node tests/test_learn_mention.mjs && node tests/test_cookie_parse.mjs && node tests/test_login_flow.mjs && node tests/test_scan_then_expire.mjs && node tests/test_qr_ttl.mjs && node tests/test_proactive_refresh.mjs"
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.0.1-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
